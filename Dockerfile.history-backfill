FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN python -m pip install --no-cache-dir 'baostock==0.9.4' 'pandas==2.2.3'

COPY src/quant_lab ./src/quant_lab
COPY scripts/backfill-history-local.sh scripts/run-history-worker.sh ./scripts/

CMD ["bash", "scripts/run-history-worker.sh"]
